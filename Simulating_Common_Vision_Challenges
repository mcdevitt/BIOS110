        }
        targetCtx.restore();
      }

      // Scene 1: Street Crossing, Traffic Signs, Pedestrian & Car (Tests peripheral, central & glare)
      function drawStreetScene(c, w, h) {
        // Sky gradient
        const sky = c.createLinearGradient(0, 0, 0, h * 0.58);
        sky.addColorStop(0, '#38bdf8');
        sky.addColorStop(1, '#bae6fd');
        c.fillStyle = sky;
        c.fillRect(0, 0, w, h * 0.58);

        // Bright sun (triggers glare in Cataracts)
        const sunX = w * 0.82;
        const sunY = h * 0.16;
        const sunGlow = c.createRadialGradient(sunX, sunY, 4, sunX, sunY, w * 0.14);
        sunGlow.addColorStop(0, '#ffffff');
        sunGlow.addColorStop(0.3, '#fef08a');
        sunGlow.addColorStop(1, 'rgba(254, 240, 138, 0)');
        c.fillStyle = sunGlow;
        c.beginPath();
        c.arc(sunX, sunY, w * 0.14, 0, Math.PI * 2);
        c.fill();

        // City buildings background
        const buildings = [
          { x: 0.03, y: 0.24, bw: 0.16, bh: 0.34, col: '#64748b' },
          { x: 0.21, y: 0.18, bw: 0.18, bh: 0.40, col: '#475569' },
          { x: 0.62, y: 0.22, bw: 0.17, bh: 0.36, col: '#64748b' },
          { x: 0.81, y: 0.28, bw: 0.17, bh: 0.30, col: '#475569' }
        ];
        buildings.forEach((b) => {
          c.fillStyle = b.col;
          c.fillRect(w * b.x, h * b.y, w * b.bw, h * b.bh);
          // Windows grid
          c.fillStyle = '#e2e8f0';
          for (let wy = b.y + 0.03; wy < 0.53; wy += 0.05) {
            for (let wx = b.x + 0.02; wx < b.x + b.bw - 0.02; wx += 0.04) {
              c.fillRect(w * wx, h * wy, w * 0.022, h * 0.028);
            }
          }
        });

        // Sidewalk & Grass
        c.fillStyle = '#22c55e';
        c.fillRect(0, h * 0.56, w, h * 0.08);
        c.fillStyle = '#cbd5e1';
        c.fillRect(0, h * 0.62, w, h * 0.08);

        // Asphalt Road
        c.fillStyle = '#334155';
        c.fillRect(0, h * 0.68, w, h * 0.32);

        // Crosswalk stripes (straight lines test Macular Degeneration waviness)
        c.fillStyle = '#f8fafc';
        for (let i = 0; i < 6; i++) {
          const sx = w * (0.28 + i * 0.075);
          c.beginPath();
          c.moveTo(sx, h * 0.71);
          c.lineTo(sx + w * 0.045, h * 0.71);
          c.lineTo(sx + w * 0.06, h * 0.96);
          c.lineTo(sx - w * 0.015, h * 0.96);
          c.closePath();
          c.fill();
        }

        // STOP Sign on Left (Tests Glaucoma peripheral loss & Left Hemianopsia)
        const stopX = w * 0.13;
        const stopY = h * 0.42;
        c.fillStyle = '#475569';
        c.fillRect(stopX - 3, stopY, 6, h * 0.25);
        c.fillStyle = '#dc2626';
        c.strokeStyle = '#ffffff';
        c.lineWidth = 3;
        const r = Math.min(w, h) * 0.075;
        c.beginPath();
        for (let i = 0; i < 8; i++) {
          const ang = (Math.PI / 4) * i + Math.PI / 8;
          const px = stopX + r * Math.cos(ang);
          const py = stopY + r * Math.sin(ang);
          i === 0 ? c.moveTo(px, py) : c.lineTo(px, py);
        }
        c.closePath();
        c.fill();
        c.stroke();
        c.fillStyle = '#ffffff';
        c.font = `bold ${Math.round(r * 0.55)}px Inter, sans-serif`;
        c.textAlign = 'center';
        c.textBaseline = 'middle';
        c.fillText('STOP', stopX, stopY + 1);

        // Center Overhead Street Sign (Tests Macular Degeneration central scotoma)
        const signW = w * 0.28;
        const signH = h * 0.095;
        const signX = (w - signW) / 2;
        const signY = h * 0.26;
        c.fillStyle = '#15803d';
        c.strokeStyle = '#ffffff';
        c.lineWidth = 3;
        c.beginPath();
        c.roundRect(signX, signY, signW, signH, 8);
        c.fill();
        c.stroke();
        c.fillStyle = '#ffffff';
        c.font = `bold ${Math.round(h * 0.036)}px Inter, sans-serif`;
        c.fillText('BIOLOGY AVE', w / 2, signY + signH * 0.38);
        c.font = `600 ${Math.round(h * 0.024)}px Inter, sans-serif`;
        c.fillStyle = '#bbf7d0';
        c.fillText('CAMPUS CROSSING', w / 2, signY + signH * 0.74);

        // Approaching Car on Right (Tests Glaucoma peripheral loss & Right Hemianopsia)
        const carX = w * 0.76;
        const carY = h * 0.72;
        c.fillStyle = '#2563eb';
        c.beginPath();
        c.roundRect(carX, carY, w * 0.19, h * 0.11, 10);
        c.fill();
        c.fillStyle = '#1d4ed8';
        c.beginPath();
        c.roundRect(carX + w * 0.03, carY - h * 0.06, w * 0.12, h * 0.07, 8);
        c.fill();
        // Headlights
        c.fillStyle = '#fef08a';
        c.beginPath();
        c.arc(carX + 6, carY + h * 0.055, 7, 0, Math.PI * 2);
        c.fill();
        // Wheels
        c.fillStyle = '#0f172a';
        c.beginPath();
        c.arc(carX + w * 0.04, carY + h * 0.11, h * 0.035, 0, Math.PI * 2);
        c.arc(carX + w * 0.15, carY + h * 0.11, h * 0.035, 0, Math.PI * 2);
        c.fill();

        // Pedestrian in Center-Left Crosswalk
        const pedX = w * 0.46;
        const pedY = h * 0.56;
        // Head
        c.fillStyle = '#fde68a';
        c.beginPath();
        c.arc(pedX, pedY, h * 0.032, 0, Math.PI * 2);
        c.fill();
        // Jacket
        c.fillStyle = '#f97316';
        c.beginPath();
        c.roundRect(pedX - w * 0.022, pedY + h * 0.035, w * 0.044, h * 0.09, 6);
        c.fill();
        // Legs
        c.strokeStyle = '#1e293b';
        c.lineWidth = 6;
        c.beginPath();
        c.moveTo(pedX - 7, pedY + h * 0.125);
        c.lineTo(pedX - 12, pedY + h * 0.21);
        c.moveTo(pedX + 7, pedY + h * 0.125);
        c.lineTo(pedX + 14, pedY + h * 0.21);
        c.stroke();
      }

      // Scene 2: Snellen Eye Chart + Prescription Bottle + Amsler Grid (Tests fine reading & distortion)
      function drawReadingScene(c, w, h) {
        // Warm desk background
        c.fillStyle = '#e2e8f0';
        c.fillRect(0, 0, w, h);

        // Left Card: Snellen Visual Acuity Chart
        const chartW = w * 0.42;
        const chartH = h * 0.84;
        const chartX = w * 0.05;
        const chartY = h * 0.08;
        c.fillStyle = '#ffffff';
        c.shadowColor = 'rgba(15, 23, 42, 0.12)';
        c.shadowBlur = 12;
        c.beginPath();
        c.roundRect(chartX, chartY, chartW, chartH, 12);
        c.fill();
        c.shadowBlur = 0;

        c.fillStyle = '#0f172a';
        c.textAlign = 'center';
        const rows = [
          { txt: 'E', size: 0.11, y: 0.19 },
          { txt: 'F P', size: 0.075, y: 0.31 },
          { txt: 'T O Z', size: 0.055, y: 0.41 },
          { txt: 'L P E D', size: 0.042, y: 0.50 },
          { txt: 'P E C F D', size: 0.032, y: 0.58 },
          { txt: 'E D F C Z P', size: 0.025, y: 0.65 },
          { txt: 'F E L O P Z D', size: 0.020, y: 0.71 }
        ];
        rows.forEach((row) => {
          c.font = `800 ${Math.round(h * row.size)}px Inter, monospace`;
          c.fillText(row.txt, chartX + chartW / 2, h * row.y);
        });

        // Red & Green horizontal bars on Snellen chart
        c.fillStyle = '#16a34a';
        c.fillRect(chartX + chartW * 0.18, h * 0.76, chartW * 0.64, 6);
        c.fillStyle = '#dc2626';
        c.fillRect(chartX + chartW * 0.25, h * 0.82, chartW * 0.50, 5);

        // Top Right: Amsler Grid (Classic Macular Degeneration straight-line diagnostic)
        const gridSize = Math.min(w * 0.36, h * 0.42);
        const gridX = w * 0.54;
        const gridY = h * 0.08;
        c.fillStyle = '#ffffff';
        c.beginPath();
        c.roundRect(gridX, gridY, gridSize, gridSize, 10);
        c.fill();

        c.strokeStyle = '#334155';
        c.lineWidth = 1.2;
        const cells = 10;
        const step = (gridSize - 24) / cells;
        const startX = gridX + 12;
        const startY = gridY + 12;
        for (let i = 0; i <= cells; i++) {
          c.beginPath();
          c.moveTo(startX + i * step, startY);
          c.lineTo(startX + i * step, startY + cells * step);
          c.stroke();

          c.beginPath();
          c.moveTo(startX, startY + i * step);
          c.lineTo(startX + cells * step, startY + i * step);
          c.stroke();
        }
        // Center fixation dot
        c.fillStyle = '#dc2626';
        c.beginPath();
        c.arc(startX + (cells * step) / 2, startY + (cells * step) / 2, 4, 0, Math.PI * 2);
        c.fill();

        // Bottom Right: Prescription Medication Label Card
        const medX = w * 0.54;
        const medY = h * 0.55;
        const medW = w * 0.41;
        const medH = h * 0.37;
        c.fillStyle = '#fffbeb';
        c.strokeStyle = '#f59e0b';
        c.lineWidth = 2;
        c.beginPath();
        c.roundRect(medX, medY, medW, medH, 10);
        c.fill();
        c.stroke();

        c.fillStyle = '#b45309';
        c.fillRect(medX, medY, medW, h * 0.065);
        c.fillStyle = '#ffffff';
        c.textAlign = 'left';
        c.font = `bold ${Math.round(h * 0.025)}px Inter, sans-serif`;
        c.fillText('Rx: EYE DROPS (TIMOLOL 0.5%)', medX + 12, medY + h * 0.042);

        c.fillStyle = '#1e293b';
        c.font = `bold ${Math.round(h * 0.026)}px Inter, sans-serif`;
        c.fillText('DOSAGE: Instill 1 drop twice daily', medX + 12, medY + h * 0.12);
        c.font = `500 ${Math.round(h * 0.022)}px Inter, sans-serif`;
        c.fillStyle = '#475569';
        c.fillText('• Wash hands before applying', medX + 12, medY + h * 0.18);
        c.fillText('• Do not touch dropper tip to eye', medX + 12, medY + h * 0.23);
