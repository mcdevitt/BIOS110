      // =========================================================================
      // 4. NON-BLOCKING TOAST NOTIFICATION HELPER
      // =========================================================================
      function showToast(message, type = 'info') {
        const container = document.getElementById('toast-container');
        const toast = document.createElement('div');
        const colors =
          type === 'success'
            ? 'bg-emerald-900 text-emerald-50 border-emerald-700'
            : type === 'error'
            ? 'bg-red-900 text-red-50 border-red-700'
            : 'bg-slate-900 text-white border-slate-700';

        toast.className = `pointer-events-auto px-4 py-2.5 rounded-xl border shadow-lg text-xs font-medium flex items-center gap-2 transition-all duration-300 translate-y-2 opacity-0 ${colors}`;
        toast.textContent = message;
        container.appendChild(toast);

        requestAnimationFrame(() => {
          toast.classList.remove('translate-y-2', 'opacity-0');
        });

        setTimeout(() => {
          toast.classList.add('translate-y-2', 'opacity-0');
          setTimeout(() => toast.remove(), 300);
        }, 3000);
      }

