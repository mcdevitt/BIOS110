      // =========================================================================
      // 6. VISION IMPAIRMENT RENDERING FILTERS
      // =========================================================================
      function renderSimulatedFrame(targetCtx, sourceCanvas, w, h, timestamp) {
        const cond = state.condition;
        const sev = state.severity / 100; // 0.2 to 1.0

        targetCtx.save();
        targetCtx.clearRect(0, 0, w, h);

        // -----------------------------------------------------------------------
        // A. GLAUCOMA (Dark Green Glasses): Progressive peripheral tunnel vision
        // -----------------------------------------------------------------------
        if (cond === 'glaucoma') {
          // Slight optic nerve contrast reduction + subtle green tint matching lab glasses
          targetCtx.drawImage(sourceCanvas, 0, 0, w, h);

          // Peripheral blur layer outside central tunnel
          fxCtx.clearRect(0, 0, w, h);
          fxCtx.filter = `blur(${Math.round(6 + sev * 10)}px)`;
          fxCtx.drawImage(sourceCanvas, 0, 0, w, h);
          fxCtx.filter = 'none';

          const cx = w * 0.5;
          const cy = h * 0.5;
          const maxDim = Math.hypot(cx, cy);
          // Tunnel radius shrinks as severity increases
          const innerR = maxDim * (0.46 - sev * 0.34);
          const outerR = innerR + maxDim * (0.28 - sev * 0.10);

          // Draw blurred periphery
          targetCtx.save();
          const blurMask = targetCtx.createRadialGradient(cx, cy, innerR * 0.85, cx, cy, outerR);
          blurMask.addColorStop(0, 'rgba(0,0,0,0)');
          blurMask.addColorStop(1, 'rgba(0,0,0,1)');
          targetCtx.globalAlpha = 0.85;
          targetCtx.drawImage(fxCanvas, 0, 0, w, h);
          targetCtx.globalAlpha = 1;
          // Re-draw crisp center inside the tunnel
          targetCtx.save();
          targetCtx.beginPath();
          targetCtx.arc(cx, cy, innerR * 1.05, 0, Math.PI * 2);
          targetCtx.clip();
          targetCtx.drawImage(sourceCanvas, 0, 0, w, h);
          targetCtx.restore();

          // Dark peripheral scotoma vignette
          const tunnelGrad = targetCtx.createRadialGradient(cx, cy, innerR * 0.75, cx, cy, outerR);
          tunnelGrad.addColorStop(0, 'rgba(2, 12, 6, 0)');
          tunnelGrad.addColorStop(0.55, 'rgba(3, 18, 10, 0.68)');
          tunnelGrad.addColorStop(1, 'rgba(1, 8, 4, 0.985)');
          targetCtx.fillStyle = tunnelGrad;
          targetCtx.fillRect(0, 0, w, h);
          targetCtx.restore();
        }

        // -----------------------------------------------------------------------
        // B. MACULAR DEGENERATION (Dark Blue Glasses): Central scotoma + wavy lines
        // -----------------------------------------------------------------------
        else if (cond === 'macular') {
          // Sharp peripheral vision
          targetCtx.drawImage(sourceCanvas, 0, 0, w, h);

          const cx = w * 0.5;
          const cy = h * 0.5;
          const radius = Math.min(w, h) * (0.14 + sev * 0.24);

          // 1) Subtle metamorphopsia (wavy distortion) around the macula
          fxCtx.clearRect(0, 0, w, h);
          const sliceHeight = 4;
          const waveAmp = 3 + sev * 9;
          const waveFreq = 0.045;
          for (let y = 0; y < h; y += sliceHeight) {
            const dy = y - cy;
            const distY = Math.abs(dy);
            if (distY < radius * 1.45) {
              const factor = Math.cos((distY / (radius * 1.45)) * (Math.PI / 2));
              const shiftX = Math.sin(y * waveFreq + timestamp * 0.0015) * waveAmp * factor;
              fxCtx.drawImage(sourceCanvas, 0, y, w, sliceHeight, shiftX, y, w, sliceHeight);
            } else {
              fxCtx.drawImage(sourceCanvas, 0, y, w, sliceHeight, 0, y, w, sliceHeight);
            }
          }

          // 2) Heavy central blur inside macular zone
          targetCtx.save();
          targetCtx.beginPath();
          targetCtx.arc(cx, cy, radius * 1.35, 0, Math.PI * 2);
          targetCtx.clip();
          targetCtx.filter = `blur(${Math.round(5 + sev * 14)}px)`;
          targetCtx.drawImage(fxCanvas, 0, 0, w, h);
          targetCtx.filter = 'none';
          targetCtx.restore();

          // 3) Gray/dark central scotoma smudge
          const scotomaGrad = targetCtx.createRadialGradient(cx, cy, radius * 0.1, cx, cy, radius * 1.15);
          const coreOpacity = 0.45 + sev * 0.48;
          scotomaGrad.addColorStop(0, `rgba(45, 52, 64, ${coreOpacity})`);
          scotomaGrad.addColorStop(0.6, `rgba(71, 85, 105, ${coreOpacity * 0.82})`);
          scotomaGrad.addColorStop(1, 'rgba(71, 85, 105, 0)');
          targetCtx.fillStyle = scotomaGrad;
          targetCtx.beginPath();
          targetCtx.arc(cx, cy, radius * 1.15, 0, Math.PI * 2);
          targetCtx.fill();
        }

        // -----------------------------------------------------------------------
        // C. CATARACTS (Light Blue Glasses): Full-frame blur, yellow haze & glare
        // -----------------------------------------------------------------------
        else if (cond === 'cataracts') {
          const blurPx = (2.5 + sev * 11).toFixed(1);
          const contrastPct = Math.round(92 - sev * 38);
          const brightnessPct = Math.round(102 + sev * 14);

          targetCtx.filter = `blur(${blurPx}px) contrast(${contrastPct}%) brightness(${brightnessPct}%) sepia(${Math.round(18 + sev * 32)}%)`;
          targetCtx.drawImage(sourceCanvas, 0, 0, w, h);
          targetCtx.filter = 'none';

          // Milky light-scattering veil (wax paper / foggy window effect)
          targetCtx.fillStyle = `rgba(254, 249, 232, ${0.14 + sev * 0.24})`;
          targetCtx.fillRect(0, 0, w, h);

          // Glare bloom overlay from bright areas
          const glareGrad = targetCtx.createRadialGradient(w * 0.75, h * 0.22, 10, w * 0.65, h * 0.3, w * 0.55);
          glareGrad.addColorStop(0, `rgba(255, 253, 240, ${0.22 + sev * 0.32})`);
          glareGrad.addColorStop(1, 'rgba(255, 253, 240, 0)');
          targetCtx.fillStyle = glareGrad;
          targetCtx.fillRect(0, 0, w, h);
        }

        // -----------------------------------------------------------------------
        // D. HEMIANOPSIA (Red Glasses): Loss of Right or Left half of visual field
        // -----------------------------------------------------------------------
        else if (cond === 'hemianopsia') {
          // Draw normal intact field first
          targetCtx.drawImage(sourceCanvas, 0, 0, w, h);

          const isRightLoss = state.hemiSide === 'right';
          const midX = w * 0.5;
          const feather = w * 0.05;

          // Blurred, washed-out/darkened blind hemifield
          fxCtx.clearRect(0, 0, w, h);
          fxCtx.filter = 'blur(18px) brightness(35%) contrast(60%)';
          fxCtx.drawImage(sourceCanvas, 0, 0, w, h);
          fxCtx.filter = 'none';

          targetCtx.save();
          targetCtx.beginPath();
          if (isRightLoss) {
            targetCtx.rect(midX - feather * 0.5, 0, w - midX + feather * 0.5, h);
          } else {
            targetCtx.rect(0, 0, midX + feather * 0.5, h);
          }
          targetCtx.clip();
          targetCtx.drawImage(fxCanvas, 0, 0, w, h);
          targetCtx.restore();

          // Smooth anatomical midline shadow gradient
          const hemiGrad = isRightLoss
            ? targetCtx.createLinearGradient(midX - feather, 0, midX + feather * 1.4, 0)
            : targetCtx.createLinearGradient(midX + feather, 0, midX - feather * 1.4, 0);

          hemiGrad.addColorStop(0, 'rgba(10, 12, 18, 0)');
          hemiGrad.addColorStop(0.5, 'rgba(10, 12, 18, 0.75)');
          hemiGrad.addColorStop(1, 'rgba(8, 10, 15, 0.94)');

          targetCtx.fillStyle = hemiGrad;
          if (isRightLoss) {
            targetCtx.fillRect(midX - feather, 0, w - (midX - feather), h);
          } else {
            targetCtx.fillRect(0, 0, midX + feather, h);
          }
        }

        // -----------------------------------------------------------------------
        // E. DETACHED RETINA (Yellow Glasses): Curtain shadow + floaters + flashes
        // -----------------------------------------------------------------------
        else if (cond === 'detached') {
          targetCtx.drawImage(sourceCanvas, 0, 0, w, h);

          // 1) Animated drifting floaters (specks & cobweb strands)
          const floaterCount = Math.round(6 + sev * 12);
          targetCtx.save();
          for (let i = 0; i < floaterCount; i++) {
            const f = floaters[i];
            f.x = (f.x + f.speedX + Math.sin(timestamp * 0.001 + f.phase) * 0.0004 + 1) % 1;
            f.y = (f.y + f.speedY) % 1;
            const fx = f.x * w;
            const fy = f.y * h;

            targetCtx.strokeStyle = 'rgba(30, 41, 59, 0.55)';
            targetCtx.fillStyle = 'rgba(30, 41, 59, 0.45)';
            if (f.isString) {
              targetCtx.lineWidth = 2;
              targetCtx.beginPath();
              targetCtx.moveTo(fx, fy);
              targetCtx.quadraticCurveTo(fx + 14, fy + 10, fx + 6, fy + 24);
              targetCtx.stroke();
            } else {
              targetCtx.beginPath();
              targetCtx.arc(fx, fy, f.r, 0, Math.PI * 2);
              targetCtx.fill();
            }
          }
          targetCtx.restore();

          // 2) Occasional peripheral light flash (photopsia) along detachment edge
          const flashWave = Math.sin(timestamp * 0.0045);
          if (flashWave > 0.88) {
            const flashAlpha = (flashWave - 0.88) * 3.5;
            const flashGrad = targetCtx.createRadialGradient(w * 0.72, h * 0.38, 4, w * 0.72, h * 0.38, w * 0.22);
            flashGrad.addColorStop(0, `rgba(255, 255, 255, ${flashAlpha})`);
            flashGrad.addColorStop(1, 'rgba(255, 255, 255, 0)');
            targetCtx.fillStyle = flashGrad;
            targetCtx.fillRect(0, 0, w, h);
          }

          // 3) Diagonal dark "curtain" shadow creeping from bottom-right
          const progress = 0.22 + sev * 0.52; // How far across the screen the curtain reaches
          const x1 = w * (1.15 - progress * 1.1);
          const y1 = h * 1.05;
          const x2 = w * 1.05;
          const y2 = h * (0.95 - progress * 1.15);

          // Gradient perpendicular to curtain edge
          const curtainGrad = targetCtx.createLinearGradient(
            w * (0.95 - progress * 0.85),
            h * (0.95 - progress * 0.85),
            w * (1.05 - progress * 0.65),
            h * (1.05 - progress * 0.65)
          );
          curtainGrad.addColorStop(0, 'rgba(5, 7, 12, 0)');
          curtainGrad.addColorStop(0.35, 'rgba(5, 7, 12, 0.82)');
          curtainGrad.addColorStop(1, 'rgba(2, 4, 8, 0.99)');

          targetCtx.fillStyle = curtainGrad;
          targetCtx.beginPath();
          targetCtx.moveTo(x1 - 40, y1);
          targetCtx.lineTo(x2, y2 - 40);
          targetCtx.lineTo(w, h);
          targetCtx.closePath();
          targetCtx.fill();
        }

        targetCtx.restore();
      }

      // =========================================================================
      // 7. MAIN ANIMATION LOOP & RESPONSIVE CANVAS RESIZING
      // =========================================================================
      function resizeCanvases() {
        const wrapper = document.getElementById('canvas-wrapper');
        const rect = wrapper.getBoundingClientRect();
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        const w = Math.max(320, Math.round(rect.width * dpr));
        const h = Math.max(240, Math.round(rect.height * dpr));

        if (canvas.width !== w || canvas.height !== h) {
          canvas.width = w;
          canvas.height = h;
          offscreenCanvas.width = w;
          offscreenCanvas.height = h;
          fxCanvas.width = w;
          fxCanvas.height = h;
        }
      }

      function drawImageCover(targetCtx, imgOrVideo, srcW, srcH, dstW, dstH, mirror = false) {
        const scale = Math.max(dstW / srcW, dstH / srcH);
        const drawW = srcW * scale;
        const drawH = srcH * scale;
        const offsetX = (dstW - drawW) / 2;
        const offsetY = (dstH - drawH) / 2;

        targetCtx.save();
        if (mirror) {
          targetCtx.translate(dstW, 0);
          targetCtx.scale(-1, 1);
        }
        targetCtx.drawImage(imgOrVideo, offsetX, offsetY, drawW, drawH);
        targetCtx.restore();
      }

      function renderLoop(timestamp) {
        resizeCanvases();
        const w = canvas.width;
        const h = canvas.height;

        // 1. Render active raw source onto offscreenCanvas
        offCtx.clearRect(0, 0, w, h);
        if (state.sourceType === 'camera' && state.cameraStream && webcamVideo.videoWidth > 0) {
          const shouldMirror = state.facingMode === 'user';
          drawImageCover(offCtx, webcamVideo, webcamVideo.videoWidth, webcamVideo.videoHeight, w, h, shouldMirror);
        } else if (state.sourceType === 'upload' && state.uploadedImage) {
          drawImageCover(offCtx, state.uploadedImage, state.uploadedImage.naturalWidth, state.uploadedImage.naturalHeight, w, h, false);
        } else {
          drawSampleScene(offCtx, w, h, state.sampleScene);
        }

        // 2. Apply simulation (or temporary unfiltered comparison while holding button)
        if (state.isComparingNormal) {
          ctx.clearRect(0, 0, w, h);
          ctx.drawImage(offscreenCanvas, 0, 0, w, h);
        } else {
          renderSimulatedFrame(ctx, offscreenCanvas, w, h, timestamp);
        }

        requestAnimationFrame(renderLoop);
      }

      // =========================================================================
      // 8. UI RENDERING & STATE SYNCHRONIZATION
      // =========================================================================
      function buildConditionButtons() {
        conditionButtonsContainer.innerHTML = '';
        Object.values(CONDITIONS).forEach((cond) => {
          const isActive = state.condition === cond.id;
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.dataset.condId = cond.id;
          btn.className = `p-2.5 rounded-xl border text-left transition flex flex-col justify-between gap-1.5 ${
            isActive
              ? `bg-white border-slate-900 ring-2 ${cond.btnRing} shadow-sm`
              : 'bg-white/80 hover:bg-white border-slate-200 text-slate-700'
          }`;

          btn.innerHTML = `
            <div class="flex items-center justify-between w-full">
              <span class="w-3 h-3 rounded-full shrink-0 border border-black/15" style="background-color: ${cond.glassesColorHex}"></span>
              <span class="text-[10px] font-semibold text-slate-400 truncate ml-1">${cond.glasses.replace(' Glasses', '')}</span>
            </div>
            <div class="font-bold text-xs sm:text-[13px] text-slate-900 leading-tight">${cond.shortName}</div>
          `;

          btn.addEventListener('click', () => selectCondition(cond.id));
          conditionButtonsContainer.appendChild(btn);
        });
      }

      function selectCondition(condId) {
        state.condition = condId;
        const cond = CONDITIONS[condId];

        buildConditionButtons();

        // Update viewport top badge
        document.getElementById('pill-dot').style.backgroundColor = cond.glassesColorHex;
        document.getElementById('pill-text').textContent = `${cond.name} — ${cond.glasses}`;

        // Toggle parameter controls
        if (cond.hasSeverity) {
          severityGroup.classList.remove('hidden');
          severityGroup.classList.add('flex');
        } else {
          severityGroup.classList.add('hidden');
          severityGroup.classList.remove('flex');
        }

        if (cond.id === 'hemianopsia') {
          hemiGroup.classList.remove('hidden');
          hemiGroup.classList.add('flex');
        } else {
          hemiGroup.classList.add('hidden');
          hemiGroup.classList.remove('flex');
        }

        // Update Educational Info Card
        const glassesBadge = document.getElementById('glasses-badge');
        glassesBadge.className = `inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-bold border ${cond.badgeBg}`;
        document.getElementById('glasses-swatch').style.backgroundColor = cond.glassesColorHex;
        document.getElementById('glasses-label').textContent = cond.glasses;
        document.getElementById('condition-title').textContent = cond.name;
        document.getElementById('condition-structure').textContent = cond.structure;
        document.getElementById('condition-description').textContent = cond.description;

        const impactsList = document.getElementById('condition-impacts');
        impactsList.innerHTML = cond.impacts
          .map(
            (item) =>
              `<li class="flex items-start gap-2"><span class="text-blue-600 font-bold mt-0.5">•</span><span>${item}</span></li>`
          )
          .join('');
      }

      // =========================================================================
      // 9. INPUT SOURCE HANDLERS (SAMPLES, IMAGE UPLOAD, WEBCAM)
      // =========================================================================
      function stopCamera() {
        if (state.cameraStream) {
          state.cameraStream.getTracks().forEach((track) => track.stop());
          state.cameraStream = null;
        }
        webcamVideo.srcObject = null;
        cameraBtnLabel.textContent = 'Turn On Camera';
        document.getElementById('flip-camera-btn').classList.add('hidden');
        document.getElementById('flip-camera-btn').classList.remove('inline-flex');
      }

      function updateSourceButtonsUI() {
        const sampleBtn = document.getElementById('src-sample-btn');
        const cameraBtn = document.getElementById('src-camera-btn');
        const flipBtn = document.getElementById('flip-camera-btn');
        const sceneSelector = document.getElementById('sample-scene-selector');

        sampleBtn.className =
          state.sourceType === 'sample'
            ? 'px-3 py-2 text-xs font-semibold rounded-xl bg-blue-600 text-white shadow-xs transition flex items-center gap-1.5'
            : 'px-3 py-2 text-xs font-semibold rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 transition flex items-center gap-1.5';

        cameraBtn.className =
          state.sourceType === 'camera'
            ? 'px-3 py-2 text-xs font-semibold rounded-xl bg-emerald-600 text-white shadow-xs transition flex items-center gap-1.5'
            : 'px-3 py-2 text-xs font-semibold rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 transition flex items-center gap-1.5';

        if (state.sourceType === 'camera') {
          flipBtn.classList.remove('hidden');
          flipBtn.classList.add('inline-flex');
        } else {
          flipBtn.classList.add('hidden');
          flipBtn.classList.remove('inline-flex');
        }

        if (state.sourceType === 'sample') {
          sceneSelector.classList.remove('hidden');
        } else {
          sceneSelector.classList.add('hidden');
        }
      }

      async function startCamera() {
        cameraOverlay.classList.add('hidden');
        stopCamera();

        if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
          const isInsecure = window.location.protocol !== 'https:' && window.location.hostname !== 'localhost';
          cameraMsgTitle.textContent = isInsecure ? 'HTTPS Required for Camera' : 'Camera Not Supported';
          cameraMsgBody.textContent = isInsecure
            ? 'Browsers require a secure (HTTPS) connection or localhost to access the webcam. Please open this file via HTTPS/localhost or use Sample Scenes / Upload Image.'
            : 'Your browser or embedded preview frame does not allow live camera access. You can download this HTML file and open it directly in Chrome/Safari/Edge, or use Sample Scenes / Upload Image.';
          cameraOverlay.classList.remove('hidden');
          return;
        }

        cameraBtnLabel.textContent = 'Starting...';

        // Progressive fallback constraints so laptops, external webcams, and phones all connect
        const constraintAttempts = [
          { video: { facingMode: state.facingMode, width: { ideal: 1280 }, height: { ideal: 720 } }, audio: false },
          { video: { facingMode: state.facingMode }, audio: false },
          { video: true, audio: false }
        ];

        let stream = null;
        let lastError = null;

        for (const constraints of constraintAttempts) {
          try {
            stream = await navigator.mediaDevices.getUserMedia(constraints);
            if (stream) break;
          } catch (err) {
            lastError = err;
          }
        }

        if (!stream) {
          cameraBtnLabel.textContent = 'Turn On Camera';
          const errName = lastError && lastError.name ? lastError.name : '';
          if (errName === 'NotAllowedError' || errName === 'PermissionDeniedError') {
            cameraMsgTitle.textContent = 'Camera Permission Blocked';
            cameraMsgBody.textContent =
              'Camera access was blocked by your browser or this preview sandbox. Click the lock/camera icon in your address bar to allow access, or open this HTML file directly in a new browser tab.';
          } else if (errName === 'NotFoundError' || errName === 'DevicesNotFoundError') {
            cameraMsgTitle.textContent = 'No Camera Detected';
            cameraMsgBody.textContent =
              'No webcam was found on this device. Please use the Sample Scenes or Upload Image buttons instead.';
          } else if (errName === 'NotReadableError' || errName === 'TrackStartError') {
            cameraMsgTitle.textContent = 'Camera In Use by Another App';
            cameraMsgBody.textContent =
              'Another application (like Zoom, Teams, or another browser tab) is currently using your camera. Close it and try again.';
          } else {
            cameraMsgTitle.textContent = 'Unable to Start Camera';
            cameraMsgBody.textContent =
              'If you are viewing this inside an embedded preview frame, camera access may be restricted by the host frame. Download the HTML file and open it directly in your browser, or use Sample Scenes / Upload Image.';
          }
          cameraOverlay.classList.remove('hidden');
          return;
        }

        try {
          state.cameraStream = stream;
          webcamVideo.setAttribute('playsinline', '');
          webcamVideo.muted = true;
          webcamVideo.srcObject = stream;

          // Wait until video metadata is ready so videoWidth/videoHeight are populated
          await new Promise((resolve) => {
            if (webcamVideo.readyState >= 1) {
              resolve();
            } else {
              webcamVideo.onloadedmetadata = () => resolve();
            }
          });

          await webcamVideo.play();
          state.sourceType = 'camera';
          cameraBtnLabel.textContent = 'Stop Camera';
          updateSourceButtonsUI();
          showToast('Live camera active!', 'success');
        } catch (playErr) {
          stopCamera();
          cameraMsgTitle.textContent = 'Video Playback Error';
          cameraMsgBody.textContent =
            'The camera connected, but video playback could not start. Please try again or use Sample Scenes / Upload Image.';
          cameraOverlay.classList.remove('hidden');
        }
      }

      // =========================================================================
      // 10. EVENT LISTENERS
      // =========================================================================
      document.getElementById('toggle-guide-btn').addEventListener('click', () => {
        document.getElementById('guide-drawer').classList.toggle('hidden');
      });

      document.getElementById('src-sample-btn').addEventListener('click', () => {
        stopCamera();
        cameraOverlay.classList.add('hidden');
        state.sourceType = 'sample';
        updateSourceButtonsUI();
      });

      document.getElementById('fallback-sample-btn').addEventListener('click', () => {
        stopCamera();
        cameraOverlay.classList.add('hidden');
        state.sourceType = 'sample';
        updateSourceButtonsUI();
      });

      document.getElementById('scene-select').addEventListener('change', (e) => {
        state.sampleScene = e.target.value;
      });

      document.getElementById('image-upload-input').addEventListener('change', (e) => {
        const file = e.target.files && e.target.files[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = (ev) => {
          const img = new Image();
          img.onload = () => {
            stopCamera();
            cameraOverlay.classList.add('hidden');
            state.uploadedImage = img;
            state.sourceType = 'upload';
            updateSourceButtonsUI();
            showToast(`Loaded "${file.name}" into simulator.`, 'success');
          };
          img.onerror = () => {
            showToast('Could not decode image file. Try a JPEG or PNG.', 'error');
          };
          img.src = ev.target.result;
        };
        reader.readAsDataURL(file);
        e.target.value = '';
      });

      document.getElementById('src-camera-btn').addEventListener('click', () => {
        if (state.sourceType === 'camera' && state.cameraStream) {
          stopCamera();
          state.sourceType = 'sample';
          updateSourceButtonsUI();
          showToast('Camera turned off.');
        } else {
          startCamera();
        }
      });

      document.getElementById('flip-camera-btn').addEventListener('click', () => {
        state.facingMode = state.facingMode === 'user' ? 'environment' : 'user';
        startCamera();
      });

      severitySlider.addEventListener('input', (e) => {
        state.severity = parseInt(e.target.value, 10);
        severityValue.textContent = `${state.severity}%`;
      });

      hemiRightBtn.addEventListener('click', () => {
        state.hemiSide = 'right';
        hemiRightBtn.className = 'px-2.5 py-1 text-xs font-semibold rounded-lg bg-red-600 text-white transition';
        hemiLeftBtn.className = 'px-2.5 py-1 text-xs font-semibold rounded-lg text-slate-300 hover:text-white transition';
      });

      hemiLeftBtn.addEventListener('click', () => {
        state.hemiSide = 'left';
        hemiLeftBtn.className = 'px-2.5 py-1 text-xs font-semibold rounded-lg bg-red-600 text-white transition';
        hemiRightBtn.className = 'px-2.5 py-1 text-xs font-semibold rounded-lg text-slate-300 hover:text-white transition';
      });

      // Hold-to-compare unfiltered view (Mouse + Touch support)
      const startCompare = (e) => {
        e.preventDefault();
        state.isComparingNormal = true;
        document.getElementById('pill-text').textContent = 'Comparing: Unfiltered View';
      };
      const endCompare = () => {
        if (!state.isComparingNormal) return;
        state.isComparingNormal = false;
        const cond = CONDITIONS[state.condition];
        document.getElementById('pill-text').textContent = `${cond.name} — ${cond.glasses}`;
      };

      compareHoldBtn.addEventListener('mousedown', startCompare);
      compareHoldBtn.addEventListener('touchstart', startCompare, { passive: false });
      window.addEventListener('mouseup', endCompare);
      window.addEventListener('touchend', endCompare);

      // Save frame snapshot
      document.getElementById('download-snap-btn').addEventListener('click', () => {
        try {
          const link = document.createElement('a');
          link.download = `BIOS110_${state.condition}_simulation.png`;
          link.href = canvas.toDataURL('image/png');
          link.click();
          showToast('Saved simulated view image!', 'success');
        } catch (err) {
          showToast('Unable to export frame.', 'error');
        }
      });

      // =========================================================================
      // 11. INITIALIZATION ON WINDOW LOAD
      // =========================================================================
      window.onload = function () {
        selectCondition('glaucoma');
        updateSourceButtonsUI();
        requestAnimationFrame(renderLoop);
      };
    })();
  </script>
</body>
</html>
